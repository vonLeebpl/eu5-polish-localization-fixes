# plf: nadpisanie waniliowego szablonu SpecificGoodsFromMarketContent
# z in_game/gui/shared/market_tooltips.gui (l. 1043).
# Wanilia ma zahardkodowany w raw_text angielski spójnik (omija loc całkowicie):
#   raw_text = "[Goods.GetName] in the @market! [Market.GetName]:"
# -> "Księgi in the [ikona] Rynek Sevilla:". [Market.GetName] już zwraca pełną
# nazwę z "Rynek" (MARKET_LONG_NAME), więc zamiast "na rynku [...]" (co dałoby
# powtórkę "rynku Rynek Sevilla") używamy myślnika, bez zmiany reszty szablonu.
template SpecificGoodsFromMarketContent {
	TooltipListBase = {
		block "data_from" { datacontext = "[Trade.GetFromMarket]" }

		datacontext = "[Market.GetMarketEntry(Goods.Self)]"

		blockoverride "block_title" {
			raw_text = "[Goods.GetName] – @market! [Market.GetName]:"
		}

		hbox = {
			margin = { 5 5 }
			using = layoutpolicy_expanding
			datacontext = "[GoodsMarketEntry.GetGoods]"
			vbox = {
				margin = { 15 0 }
				spacing = 3
				hbox = {
					#spacing = 3
					text_single = {
						maximumsize = { 45 20 }
						align = left|nobaseline
						using = Font_Size_Small
						text = "game_concept_goods"
					}
				}
				hbox = {
					button = {
						size = { 22 22 }
						texture = "[GetGoodsIcon(Goods.Self)]"
					}
					tooltipwidget = {
						using = Goods_tooltip
					}

					widget = {
						size = {15 22}

						progressbar = {
							parentanchor = center
							size = { 5 22 }
							using = progress_bar_green_alt
							min = 0
							max = "[FixedPointToFloat(Market.GetCenterLocation.GetModifierValueFixed('maximum_stockpile_capacity'))]"
							direction = vertical
							value = "[FixedPointToFloat(GoodsMarketEntry.GetStockpile)]"
						}
						tooltipwidget = {
							using = GoodsMarketEntry_template
						}
					}
				}
			}

			hbox = {
				using = layoutpolicy_expanding
				spacing = 5
				widget = {
					size = { 65 40 }
					vbox = {
						spacing = 5
						parentanchor = center
						text_single = {
							maximumsize = { 55 20 }
							align = center
							using = Font_Size_Small
							text = "game_concept_supply"
						}
						hbox = {
							spacing = 3
							text_single = {
								maximumsize = { 45 20 }
								align = center
								using = Font_Size_Small
								text = "[Market.GetSupplyLabel(GoodsMarketEntry.GetGoods)]"
							}

							icon = {
								visible = "[StringIsEmpty(Market.GetSupplyFromTradesInfo(GoodsMarketEntry.GetGoods))]"
								size = { 18 18 }
								texture = "gfx/interface/icons/flat_icons/trade_market/supply.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 2
									color = {0.0 0.0 0.0 1.0}
									alpha = 0.2
								}
							}

							icon = {
								visible = "[Not(StringIsEmpty(Market.GetSupplyFromTradesInfo(GoodsMarketEntry.GetGoods)))]"
								size = { 18 18 }
								texture = "gfx/interface/icons/flat_icons/trade_market/supply_with_import.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = {0.0 0.0 0.0 1.0}
									alpha = 0.3
								}
							}
						}
					}
				}

				widget = {
					size = { 65 40 }
					vbox = {
						spacing = 5
						parentanchor = center
						text_single = {
							maximumsize = { 55 20 }
							align = center
							using = Font_Size_Small
							text = "game_concept_demand"
						}
						hbox = {
							spacing = 3
							text_single = {
								maximumsize = { 45 20 }
								align = center
								using = Font_Size_Small
								text = "[Market.GetDemandLabel(GoodsMarketEntry.GetGoods)]"
							}

							icon = {
								visible = "[StringIsEmpty(Market.GetDemandFromTradesInfo(GoodsMarketEntry.GetGoods))]"
								size = { 18 18 }
								texture = "gfx/interface/icons/flat_icons/trade_market/demand.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = {0.0 0.0 0.0 1.0}
									alpha = 0.3
								}
							}

							icon = {
								visible = "[Not(StringIsEmpty(Market.GetDemandFromTradesInfo(GoodsMarketEntry.GetGoods)))]"
								size = { 18 18 }
								texture = "gfx/interface/icons/flat_icons/trade_market/demand_with_export.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = {0.0 0.0 0.0 1.0}
									alpha = 0.3
								}
							}
						}
					}
				}
				widget = {
					size = { 65 40 }
					tooltipwidget = {
						using = goods_market_balance_tooltip
					}
					vbox = {
						spacing = 5
						parentanchor = center
						text_single = {
							maximumsize = { 55 20 }
							align = center
							using = Font_Size_Small
							text = "game_concept_market_balance_short"
						}
						text_single = {
							size = { 65 20 }
							autoresize = no
							align = center
							using = Font_Size_Small
							raw_text = "[Subtract_CFixedPoint(Market.GetSupply(GoodsMarketEntry.GetGoods), Market.GetDemand(GoodsMarketEntry.GetGoods))|+=2]@balance!"

							datacontext = "[GoodsMarketEntry.GetGoods]"
						}
					}
				}

				widget = {
					size = { 65 40 }
					tooltipwidget = {
						using = goods_market_price_tooltip
					}
					vbox = {
						spacing = 5
						parentanchor = center
						text_single = {
							maximumsize = { 55 20 }
							align = center
							using = Font_Size_Small
							text = "game_concept_price"
						}
						text_single = {
							size = { 68 20 }
							autoresize = no
							align = center
							using = Font_Size_Small
							# raw_text = "[GoodsMarketEntry.GetPrice|2]@[GoodsMarketEntry.GetGoods.GetPriceDifferenceIconName(GoodsMarketEntry.GetPrice)]!"
							raw_text = "[Market.GetPriceWithChange(GoodsMarketEntry.GetGoods)|2]"
						}
					}
				}
			}
		}
	}
}
